  "info": {
    "title": "Ghahvehto Foundation API",
    "description": "Local read-only foundation. Authentication and business transactions are not enabled.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "BootstrapDto": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "example": "قهوه‌تو"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fa-IR"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "rtl"
            ]
          },
          "environment": {
            "type": "string",
            "enum": [
              "development"
            ]
          },
          "dataMode": {
            "type": "string",
            "enum": [
              "empty"
            ]
          },
          "loyaltyEnabled": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "brand",
          "locale",
          "direction",
          "environment",
          "dataMode",
          "loyaltyEnabled"
        ]
      },
      "CafeAccessDto": {
        "type": "object",
        "properties": {
          "cafeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "cafeId",
          "name"
        ]
      },
      "BranchAccessDto": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "cafeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "branchId",
          "cafeId",
          "name"
        ]
      },
      "UpdateCafeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
